# Database Configuration (Optional)
# If not provided, NovaWorkstations automatically uses a local SQLite database in data/nova.db
DATABASE_URL=postgresql://user:password@localhost:5432/novaworkstations

# Supabase / Vercel Postgres alternative variables:
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# Application Settings
# Public origin used for canonical URLs and structured data (no trailing slash).
# When unset the site falls back to https://planiaula.com; set it to the real domain.
NEXT_PUBLIC_SITE_URL=
STORE_NAME=NovaWorkstations
ADMIN_TOKEN=secret-admin-token
# Secret used to sign admin session cookies. REQUIRED in production (and on Vercel):
# without it admin login and every admin session check fail closed. Use a long random
# string, e.g. `openssl rand -hex 32`. In local development (`next dev`) it may stay empty:
# a fixed, insecure development-only default is used (with a console warning) so admin login
# works. Set it in .env.local to override that default.
ADMIN_SESSION_SECRET=
WEBHOOK_SECRET=
