# Database Configuration (Optional)
# If not provided, NovaWorkstations automatically uses a local SQLite database in data/nova.db
DATABASE_URL=postgresql://user:password@localhost:5432/novaworkstations

# Supabase / Vercel Postgres alternative variables:
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# Application Settings
NEXT_PUBLIC_SITE_URL=http://localhost:3000
STORE_NAME=NovaWorkstations
ADMIN_TOKEN=secret-admin-token
# Secret used to sign admin session cookies. REQUIRED in production (and on Vercel):
# without it admin login and every admin session check fail closed. Use a long random
# string, e.g. `openssl rand -hex 32`. In development a random per-process fallback is
# used when this is empty, so sessions reset on restart.
ADMIN_SESSION_SECRET=
WEBHOOK_SECRET=
