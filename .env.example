# Database Configuration (Optional)
# If not provided, NovaWorkstations automatically uses a local SQLite database in data/nova.db
DATABASE_URL=postgresql://user:password@localhost:5432/novaworkstations

# Supabase / Vercel Postgres alternative variables:
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# Application Settings
NEXT_PUBLIC_SITE_URL=http://localhost:3000
STORE_NAME=NovaWorkstations
ADMIN_TOKEN=secret-admin-token
WEBHOOK_SECRET=
